# ── Imagen FastAPI (backend/api/main.py) ─────────────────────────────────────
#
# Solo copia backend/ — no necesita frontend/, data/, tests/ ni supabase/.
# Las variables de entorno (JWT_SECRET, OPENAI_API_KEY, etc.) llegan desde
# ECS task definition → AWS Secrets Manager; no se usa .env en producción.

FROM python:3.12-slim

# gcc: compilar extensiones C (tiktoken, pydantic-core, psycopg)
# No se instala curl: arrastra libcurl→libsasl2 (CVEs sin parche en Debian);
# el health check usa la stdlib de Python.
# upgrade: aplica los parches de seguridad de Debian disponibles sobre la
# imagen base (Snyk reportaba CVEs en zlib, brotli, libsasl2, etc.).
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Dependencias (capa cacheada; se invalida solo si cambia requirements/api.txt)
COPY requirements/api.txt requirements/api.txt
RUN pip install --no-cache-dir -r requirements/api.txt

# ── Código (solo backend/)
COPY backend/ backend/

EXPOSE 8000

# ECS usa el health check para marcar la tarea como healthy antes de
# registrarla en el target group del ALB. start-period=30s da tiempo
# al grafo LangGraph a conectar con el checkpointer de Postgres al arrancar.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import http.client,sys;c=http.client.HTTPConnection('localhost',8000,timeout=4);c.request('GET','/health');sys.exit(0 if c.getresponse().status==200 else 1)"

CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
