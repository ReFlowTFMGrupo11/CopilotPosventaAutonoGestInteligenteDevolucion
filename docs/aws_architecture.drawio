                    <mxGeometry x="700" y="230" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="pub_note" value="Solo el frontend recibe tráfico público (listener :443 del ALB). La API y los MCP servers son internos — no tienen listener, solo se alcanzan vía Service Connect dentro de la VPC." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="880" y="225" width="460" height="60" as="geometry"/>
