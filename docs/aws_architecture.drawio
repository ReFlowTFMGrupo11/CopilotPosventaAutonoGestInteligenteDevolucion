    <diagram id="aws-architecture" name="Arquitectura AWS (ECS Fargate)">
        <mxGraphModel dx="1780" dy="648" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
