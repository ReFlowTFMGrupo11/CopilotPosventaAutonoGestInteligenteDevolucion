                <mxCell id="title" value="&lt;b&gt;ReFlow — Arquitectura de despliegue en AWS (ECS Fargate)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="600" y="10" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Supabase y Langfuse son servicios cloud externos (SaaS) — NO se despliegan dentro de AWS, solo se consumen vía HTTPS/Postgres desde la VPC" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#666666;" parent="1" vertex="1">
