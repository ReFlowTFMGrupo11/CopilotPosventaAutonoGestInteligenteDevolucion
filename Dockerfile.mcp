# ── Imagen MCP servers (mcp_supabase :8001 y mcp_logistics :8002) ────────────
#
# Una sola imagen para ambos servidores MCP. En ECS el CMD se sobreescribe
# por servicio en la task definition:
#   mcp-supabase:  python -m backend.mcp.mcp_supabase
#   mcp-logistics: python -m backend.mcp.mcp_logistics
#
# Los MCP servers solo importan de backend/models/, backend/services/ y
# backend/db/ — no necesitan LangChain, LangGraph, FastAPI ni Langfuse.
# Imagen resultante ~3x más pequeña que la imagen de la API.
#
# Las variables de entorno (SUPABASE_URL, OPENAI_API_KEY, etc.) llegan
# desde ECS task definition → AWS Secrets Manager.

FROM python:3.12-slim

# gcc: compilar extensiones C (pydantic-core, tiktoken)
# No se instala curl: arrastra libcurl→libsasl2 (CVEs sin parche en Debian);
# el health check usa la stdlib de Python.
# upgrade: aplica los parches de seguridad de Debian disponibles sobre la
# imagen base (Snyk reportaba CVEs en zlib, brotli, libsasl2, etc.).
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Dependencias (capa cacheada)
COPY requirements/mcp.txt requirements/mcp.txt
RUN pip install --no-cache-dir -r requirements/mcp.txt

# ── Código (solo backend/ — los MCP servers no usan frontend/ ni agents/)
COPY backend/ backend/

# logistics_service.py crea generated_labels/ al importarse (exist_ok=True),
# pero crearlo aquí explícitamente evita un error de permisos si el proceso
# no tiene acceso de escritura al arrancar por primera vez.
RUN mkdir -p generated_labels

# Puerto por defecto: mcp_supabase. mcp_logistics sobreescribe el CMD
# en su task definition de ECS (y expone 8002 allí).
EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import http.client,sys;c=http.client.HTTPConnection('localhost',8001,timeout=4);c.request('GET','/mcp');sys.exit(0 if c.getresponse().status in (200,400,406) else 1)"

CMD ["python", "-m", "backend.mcp.mcp_supabase"]
