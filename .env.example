SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
OPENAI_API_KEY=your-openai-api-key

# "development" (default) | "production". En production, un fallo al conectar
# con SUPABASE_DB_URL (checkpointer persistente) frena el arranque en vez de
# degradar en silencio a InMemorySaver (backend/agents/graph.py).
# ENVIRONMENT=production

# URL del pooler de Postgres de Supabase (backend/agents/graph.py), para el
# checkpointer persistente (AsyncPostgresSaver) de LangGraph. Opcional: sin
# ella, el grafo cae a InMemorySaver (funciona, pero no persiste entre
# reinicios del proceso).
# SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:6543/postgres

# ── Controles anti-bucle / anti-gasto descontrolado ────────────────────────
# Todas opcionales, con valores por defecto razonables. Ver PR de
# "controles de terminación de agentes" para el detalle de qué protege cada una.

# Timeout (segundos) de cada llamada individual al LLM (backend/agents/llm_factory.py).
# LLM_TIMEOUT_SECONDS=60

# Límite de tokens de SALIDA por llamada al LLM (antes fijo en 4096 sin poder ajustarlo).
# LLM_MAX_OUTPUT_TOKENS=4096

# Nº máximo de mensajes de historial que se mandan al LLM en triage/evaluator
# (antes se mandaba la conversación completa sin límite).
# MAX_HISTORY_MESSAGES=20

# Timeout (segundos) de las llamadas HTTP a los MCP servers (backend/agents/infra/mcp_client.py).
# MCP_TIMEOUT_SECONDS=30
# MCP_SSE_READ_TIMEOUT_SECONDS=60

# recursion_limit explícito de LangGraph (antes se dejaba el default implícito del SDK, 25).
# GRAPH_RECURSION_LIMIT=25

# Timeout (segundos) de un turno completo del grafo (chat.py / admin.py). Si se
# agota, se cancela y se informa al cliente en vez de dejar la petición colgada.
# GRAPH_TURN_TIMEOUT_SECONDS=60

# Nº máximo de turnos de usuario por conversación (thread_id) antes de pedirle
# que abra una conversación nueva. 0 desactiva el límite.
# MAX_CONVERSATION_TURNS=40

# Opcional (solo si ves FileNotFoundError / SSL en httpx en Windows).
# Ruta absoluta al cacert.pem de 'certifi' dentro de tu .venv del proyecto.
# Obtenerla con: .venv\Scripts\python -c "import certifi; print(certifi.where())"
# SSL_CERT_FILE=C:\ruta\a\tu\proyecto\.venv\Lib\site-packages\certifi\cacert.pem

# Nodo Triaje (backend/agents/nodes/triage.py) — opcionales, ya tienen
# estos valores por defecto. TRIAGE_MODEL_TEMPERATURE/TRIAGE_MODEL_MAX_TOKENS
# sobreescriben los valores por defecto del nodo (0 y LLM_MAX_OUTPUT_TOKENS).
MCP_SUPABASE_URL=http://localhost:8001/mcp
TRIAGE_MODEL=gpt-5-mini
# TRIAGE_MODEL_TEMPERATURE=0
# TRIAGE_MODEL_MAX_TOKENS=4096

# Nodo Evaluador de políticas (backend/agents/nodes/evaluator.py) — opcional,
# ya tiene este valor por defecto.
EVALUATOR_MODEL=gpt-5-mini
# EVALUATOR_MODEL_TEMPERATURE=0
# EVALUATOR_MODEL_MAX_TOKENS=4096

# Nodo Resolución (backend/agents/nodes/resolution.py) — opcionales, ya
# tienen estos valores por defecto.
MCP_LOGISTICS_URL=http://localhost:8002/mcp
RESOLVER_MODEL=gpt-5-mini
# RESOLVER_MODEL_TEMPERATURE=0.4
# RESOLVER_MODEL_MAX_TOKENS=4096
HITL_THRESHOLD_EUR=100

# Umbral de similitud coseno para la búsqueda RAG de políticas.
# 0.5, calibrado contra la BD real (16 categorías, ver defenderRAG.md §4.1).
# RAG_MATCH_THRESHOLD=0.5
# Modelo común a la ingesta y a las consultas RAG (1536 dimensiones en pgvector).
# Si cambia, reingesta TODAS las políticas y recalibra RAG_MATCH_THRESHOLD.
# Un modelo con otras dimensiones requiere además adaptar la columna VECTOR y la RPC.
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Precios de LLM para el dashboard de costes (backend/services/pricing.py,
# frontend/pages/2_Costes.py) — opcionales, ya tienen precios por defecto
# para gpt-5-nano/gpt-5-mini. Solo hace falta fijarlas para corregir un
# precio desactualizado o dar de alta un modelo nuevo sin redeployar.
# USD_TO_EUR_RATE=0.86
# LLM_PRICES_JSON={"gpt-5-mini": [0.25, 2.00], "gpt-5-nano": [0.05, 0.40]}

# Autenticación JWT — ver backend/services/auth_service.py.
# JWT_SECRET: clave de firma de tokens. Genérala con:
#   openssl rand -hex 32
# En AWS, ponla en Secrets Manager (no en el Dockerfile ni en Terraform).
# JWT_SECRET=cambia-esto-por-openssl-rand-hex-32
# JWT_EXPIRY_HOURS=8
#
# Contraseña del panel de administración (POST /api/auth/admin/login).
# ADMIN_PASSWORD=cambia-esto-por-una-contrasena-segura

# Langfuse (tracing de LLM) — opcional, ver backend/services/observability.py.
# Si se dejan vacías, el tracing se desactiva y la app funciona igual.
# Usa Langfuse Cloud (cloud.langfuse.com, tier gratuito): crea una cuenta,
# copia las keys de tu proyecto aquí. LANGFUSE_BASE_URL no hace falta
# tocarlo (por defecto ya apunta a Cloud).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Email transaccional por AWS SES — ver backend/services/logistics_service.py.
# Si SES_SENDER_EMAIL está vacío, el envío es simulado (solo escribe en
# generated_labels/notifications_log.jsonl). Con SES no hay contraseñas: en
# ECS las credenciales las da el IAM task role; en local, tu perfil AWS.
# La identidad del remitente debe estar verificada en SES (en sandbox, el
# destinatario también).
# SES_SENDER_EMAIL=tamiruiz3@gmail.com
# SES_REGION=eu-west-1
# SES_RECIPIENT_OVERRIDE=tamiruiz3@gmail.com
