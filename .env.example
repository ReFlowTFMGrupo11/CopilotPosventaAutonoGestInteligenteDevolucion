SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
OPENAI_API_KEY=your-openai-api-key

# Agente 1 (agente1ConMCP) — opcionales, ya tienen estos valores por defecto.
MCP_SUPABASE_URL=http://localhost:8001/mcp
AGENTE1_MODEL=openai:gpt-4o-mini

# Agente 3 (agente3ConMCP) — opcionales, ya tienen estos valores por defecto.
MCP_LOGISTICS_URL=http://localhost:8002/mcp
AGENTE3_MODEL=openai:gpt-4o-mini
HITL_THRESHOLD_EUR=100
