# Variables para el docker-compose de ESTA carpeta (stack Langfuse v4
# self-hosted: Postgres + ClickHouse + Redis + MinIO + langfuse-web/worker).
# Copia este fichero a ".env" (en esta misma carpeta) y rellena los valores.
# NUNCA subir el .env real a git.
#
# Los nombres de abajo son EXACTOS a los que lee docker-compose.yml
# (no los cambies, o el compose no los encontrará).

# ── Secretos de infraestructura (uno por servicio) ─────────────────────────
# Genera cada uno con: openssl rand -base64 32
# (o en Windows sin openssl: python -c "import secrets; print(secrets.token_urlsafe(32))")
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
NEXTAUTH_SECRET=
SALT=

# Excepción: este SÍ tiene un formato concreto (32 bytes en hexadecimal).
# Genera con: openssl rand -hex 32
# (o en Windows sin openssl: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY=

# ── Bootstrap automático (opcional, pero recomendado) ──────────────────────
# Si rellenas TODO este bloque, Langfuse crea la organización, el proyecto,
# tu usuario admin y registra el par de API keys que elijas AQUÍ, en el
# primer arranque — no hace falta entrar a la UI a registrarte a mano ni
# generar las keys después. Si lo dejas en blanco, tendrás que hacerlo desde
# la UI (http://localhost:3000) la primera vez, como en la v2.
#
# LANGFUSE_INIT_ORG_ID y LANGFUSE_INIT_PROJECT_ID son identificadores
# internos (cualquier texto corto en minúsculas sirve, p. ej. "reflow" y
# "reflow-dev"); no confundir con las API keys.
LANGFUSE_INIT_ORG_ID=reflow
LANGFUSE_INIT_ORG_NAME=ReFlow
LANGFUSE_INIT_PROJECT_ID=reflow-dev
LANGFUSE_INIT_PROJECT_NAME=PosventaInteligenteDevolucion

# Genera este par tú mismo (no hace falta que existan en ningún sitio antes,
# los registra Langfuse la primera vez que arranca con este .env):
#   pk: python -c "import secrets; print('pk-lf-' + secrets.token_hex(16))"
#   sk: python -c "import secrets; print('sk-lf-' + secrets.token_hex(16))"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Las 3 líneas siguientes NO las usa este docker-compose, las usa la app
# Python (backend). Deben coincidir con LANGFUSE_INIT_PROJECT_PUBLIC_KEY /
# LANGFUSE_INIT_PROJECT_SECRET_KEY de arriba. Cópialas al .env de la RAÍZ
# del proyecto (junto a OPENAI_API_KEY, SUPABASE_*, etc.):
# ─────────────────────────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
