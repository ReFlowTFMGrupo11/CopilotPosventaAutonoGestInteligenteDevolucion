#!/usr/bin/env bash
# Arranca ReFlow completo: crea/actualiza el entorno virtual, instala
# dependencias y levanta los 4 procesos (MCP Supabase, MCP Logistics,
# API FastAPI y frontend Streamlit), cada uno en su propia ventana de
# terminal.
#
# Compatible con:
#   - Windows + Git Bash (abre cada proceso en una ventana de Git Bash)
#   - macOS   (abre cada proceso en una ventana de Terminal.app)
#
# Uso:  ./start_all.sh
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# ---------------------------------------------------------------------------
# 0. Detectar plataforma
# ---------------------------------------------------------------------------
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) PLATFORM="windows" ;;
    Darwin)                PLATFORM="mac" ;;
    *)
        echo "Plataforma no soportada: $(uname -s)." >&2
        echo "Este script solo soporta Windows con Git Bash y macOS." >&2
        exit 1
        ;;
esac

if [ "$PLATFORM" = "windows" ]; then
    GIT_BASH="/c/Program Files/Git/git-bash.exe"
    if [ ! -f "$GIT_BASH" ]; then
        echo "No se encuentra Git Bash en '$GIT_BASH'." >&2
        echo "Edita GIT_BASH en este script con la ruta correcta." >&2
        exit 1
    fi
    VENV_PY="$REPO_ROOT/.venv/Scripts/python.exe"
    VENV_ACTIVATE=".venv/Scripts/activate"
else
    if ! command -v osascript >/dev/null 2>&1; then
        echo "No se encuentra 'osascript' (se usa para abrir ventanas de Terminal.app)." >&2
        exit 1
    fi
    VENV_PY="$REPO_ROOT/.venv/bin/python"
    VENV_ACTIVATE=".venv/bin/activate"
fi

# ---------------------------------------------------------------------------
# 1. Desactivar conda si está activo en esta terminal: su python/pip no deben
# usarse para crear el .venv del proyecto, y su activate.d suele dejar puesto
# SSL_CERT_FILE (a veces roto) que interfiere con las conexiones HTTPS/SSL.
# ---------------------------------------------------------------------------
if [ -n "${CONDA_PREFIX:-}" ]; then
    echo "==> Entorno conda activo detectado (${CONDA_DEFAULT_ENV:-desconocido}), desactivando..."
    if declare -F conda >/dev/null 2>&1; then
        # 'conda' está cargado como función de shell (conda init): usar
        # 'conda deactivate' tantas veces como niveles apilados haya.
        while [ -n "${CONDA_PREFIX:-}" ]; do
            conda deactivate
        done
    else
        # Sin la función de shell (script no interactivo): limpiar a mano lo
        # que deja puesto la activación de conda.
        PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vi '/conda' | paste -sd: -)"
        export PATH
        unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL CONDA_PROMPT_MODIFIER CONDA_PYTHON_EXE
        unset SSL_CERT_FILE SSL_CERT_DIR __CONDA_OPENSSL_CERT_FILE_SET __CONDA_OPENSSL_CERT_DIR_SET
    fi
fi

# ---------------------------------------------------------------------------
# 2. Comprobar que el código de esta rama trae todo lo necesario para el
# end-to-end. backend/api y frontend/ no están presentes en todas las ramas
# del repo; si faltan, fallar aquí con un mensaje claro en vez de dejar que
# uvicorn/streamlit revienten más abajo con un error críptico.
# ---------------------------------------------------------------------------
missing=()
[ -f "$REPO_ROOT/backend/api/main.py" ] || missing+=("backend/api/main.py")
[ -f "$REPO_ROOT/frontend/Chat.py" ] || missing+=("frontend/Chat.py")

if [ "${#missing[@]}" -gt 0 ]; then
    echo "==> Faltan ficheros necesarios para el end-to-end en esta rama:" >&2
    for f in "${missing[@]}"; do
        echo "      - $f" >&2
    done
    echo "    Estos ficheros existen en la rama 'cris-UI.test.streamlit'." >&2
    echo "    Trae ese código (merge/checkout) antes de volver a ejecutar start_all.sh." >&2
    exit 1
fi

if ! grep -qi '^fastapi' requirements.txt || ! grep -qi '^uvicorn' requirements.txt || ! grep -qi '^streamlit' requirements.txt; then
    echo "==> requirements.txt no incluye fastapi/uvicorn/streamlit." >&2
    echo "    La API y el frontend no podrán arrancar sin esas dependencias." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. Entorno virtual
# ---------------------------------------------------------------------------
if [ ! -f "$REPO_ROOT/$VENV_ACTIVATE" ]; then
    echo "==> Creando entorno virtual .venv..."
    if command -v python3 >/dev/null 2>&1; then
        python3 -m venv .venv
    else
        python -m venv .venv
    fi
fi

# ---------------------------------------------------------------------------
# 4. Dependencias
# ---------------------------------------------------------------------------
echo "==> Instalando/actualizando dependencias (pip install -r requirements.txt)..."
"$VENV_PY" -m pip install -q -r requirements.txt

# ---------------------------------------------------------------------------
# 5. Variables de entorno
# ---------------------------------------------------------------------------
if [ ! -f "$REPO_ROOT/.env" ]; then
    echo "==> No existe .env, copiando .env.example -> .env"
    cp "$REPO_ROOT/.env.example" "$REPO_ROOT/.env"
    echo "    AVISO: edita .env con tus credenciales reales antes de usar la app."
fi

# ---------------------------------------------------------------------------
# 6. Lanzar cada servicio en su propia ventana de terminal
# ---------------------------------------------------------------------------
launch() {
    local title="$1"
    local cmd="$2"
    local script_file
    script_file="$(mktemp "${TMPDIR:-/tmp}/reflow_launch_XXXXXX.sh")"

    cat > "$script_file" <<EOF
#!/usr/bin/env bash
cd "$REPO_ROOT"
source "$VENV_ACTIVATE"
printf '\n== %s ==\n\n' "$title"
$cmd
status=\$?
echo
if [ "\$status" -ne 0 ]; then
    echo "[proceso terminado con error (código \$status), pulsa Enter para cerrar]"
else
    echo "[proceso terminado, pulsa Enter para cerrar]"
fi
read -r
rm -f "$script_file"
EOF
    chmod +x "$script_file"

    if [ "$PLATFORM" = "windows" ]; then
        "$GIT_BASH" -c "bash '$script_file'" &
    else
        osascript -e "tell application \"Terminal\" to do script \"bash '$script_file'\"" >/dev/null
    fi
}

echo "==> Lanzando MCP Supabase (http://localhost:8001/mcp)..."
launch "MCP Supabase (8001)" "python -m backend.mcp.mcp_supabase"
sleep 2

echo "==> Lanzando MCP Logistics (http://localhost:8002/mcp)..."
launch "MCP Logistics (8002)" "python -m backend.mcp.mcp_logistics"
sleep 2

echo "==> Lanzando API FastAPI (http://localhost:8000)..."
launch "API FastAPI (8000)" "uvicorn backend.api.main:app --reload --port 8000"
sleep 3

echo "==> Lanzando frontend Streamlit (http://localhost:8501)..."
launch "Frontend Streamlit (8501)" "streamlit run frontend/Chat.py"

cat <<EOF

==> Listo. 4 ventanas de terminal abiertas:
      - MCP Supabase   -> http://localhost:8001/mcp
      - MCP Logistics  -> http://localhost:8002/mcp
      - API FastAPI    -> http://localhost:8000 (docs en /docs)
      - Frontend       -> http://localhost:8501

    Cierra cada ventana (o Ctrl+C dentro de ella) para parar ese servicio.
EOF
