# ── Imagen Streamlit (frontend/app.py) ───────────────────────────────────────
#
# Solo copia frontend/ — completamente independiente del backend.
# No necesita LangChain, Supabase, OpenAI ni ninguna dep del backend.
# Sin gcc: todas las dependencias tienen wheels binarios para Python 3.12.
#
# WORKDIR /app + COPY frontend/ . → los imports relativos del frontend
# funcionan igual que en local:
#   from lib import api, styles        (lib/ está en /app/lib/)
#   st.Page("Chat.py", ...)            (Chat.py está en /app/Chat.py)
#   st.Page("pages/1_Admin.py", ...)   (pages/ está en /app/pages/)
#
# API_BASE_URL llega como variable de entorno desde ECS task definition
# apuntando a la URL del ALB: https://reflow-alb-xxx.eu-west-1.elb.amazonaws.com

FROM python:3.12-slim

# curl: health check del contenedor (sin gcc — no hay extensiones C que compilar)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Dependencias (capa cacheada)
COPY requirements/frontend.txt requirements/frontend.txt
RUN pip install --no-cache-dir -r requirements/frontend.txt

# ── Código (solo frontend/; el contenido se copia directamente en /app)
COPY frontend/ .

EXPOSE 8501

# Streamlit expone /_stcore/health como endpoint de salud propio.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
